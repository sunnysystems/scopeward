<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>scopeward · {{.OrgLogin}}</title>
<style>
  /* Sunny Systems design system v1.0 — inline CSS + one small inline script for
     the findings filter, fully self-contained. No external assets and no network
     calls: fonts fall back to system stacks and the Sunny logo is a base64 data
     URI. The script only filters the DOM; with JS disabled, all findings show. */
  :root{
    --amber:#FFB61F; --yellow:#F0C840; --yellow-light:#F5D660; --dark:#332C15;
    --black:#1A1A1D; --gray-dark:#3A3A3A; --gray-mid:#8F8F8F; --gray-light:#DFDFDF; --white:#FFFFFF;
    --card:#1C2020; --line:#2A2A2A;
    --ok:#3FB950; --danger:#F85149;
    --font-display:'Bricolage Grotesque','Inter',system-ui,-apple-system,"Segoe UI",sans-serif;
    --font-body:'Inter',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    --radius-sm:2px; --radius-md:4px; --radius-lg:8px; --radius-xl:12px;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--black);color:var(--gray-light);
    font-family:var(--font-body);font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased}
  .wrap{max-width:960px;margin:0 auto;padding:48px 24px 80px}
  a{color:var(--amber);text-decoration:none}
  a:hover{text-decoration:underline}

  /* Header */
  header.top{display:flex;align-items:center;gap:12px;padding-bottom:18px}
  .sunlogo{flex:0 0 auto;display:block;height:26px;width:auto}
  .hsep{flex:0 0 auto;width:1px;height:20px;background:var(--line)}
  .brand{font-family:var(--font-display);font-weight:700;font-size:26px;letter-spacing:-.5px;
    background:linear-gradient(95deg,var(--amber),var(--yellow-light));
    -webkit-background-clip:text;background-clip:text;color:transparent}
  .org{font-family:var(--font-display);font-weight:500;font-size:16px;color:var(--gray-mid)}
  .gen{margin-left:auto;color:var(--gray-mid);font-size:11px}
  hr.rule{height:1px;width:60px;background:var(--amber);border:0;margin:0 0 28px}

  /* Scorecard hero */
  .scorecard{position:relative;display:flex;gap:28px;align-items:center;background:var(--card);
    border:.5px solid var(--line);border-radius:var(--radius-xl);padding:28px;margin-bottom:14px;overflow:hidden}
  .scorecard::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--amber)}
  .gauge{width:118px;height:118px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    flex-direction:column;flex:0 0 auto;
    background:radial-gradient(closest-side,var(--card) 78%,transparent 80% 100%),
      conic-gradient(var(--grade-color) calc(var(--score)*1%), #2a2f2f 0);}
  .gauge .val{font-family:var(--font-display);font-size:32px;font-weight:700;line-height:1;color:var(--white)}
  .gauge .grade{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gray-mid);margin-top:4px}
  .scoremeta h1{font-family:var(--font-display);margin:0 0 6px;font-size:22px;font-weight:700;color:var(--white)}
  .scoremeta p{margin:0;color:var(--gray-mid);font-size:12px}
  .tally{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}

  /* Dashboard summary — stat cards, severity distribution, breakdowns. Severity
     fills are solid here (distinct from the outline chips above). */
  .sev-fill-critical{background:#F85149}
  .sev-fill-high{background:#F0883E}
  .sev-fill-medium{background:#F0C840}
  .sev-fill-low{background:#45C4B0}
  .sev-fill-info{background:#8F8F8F}

  .stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:26px}
  .stat{background:var(--card);border:.5px solid var(--line);border-radius:var(--radius-lg);padding:18px 20px}
  .stat .num{font-family:var(--font-display);font-size:34px;font-weight:700;line-height:1;color:var(--white)}
  .stat .num.crit{color:#F85149}
  .stat .num.high{color:#F0883E}
  .stat .lbl{margin-top:8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.8px;color:var(--gray-mid)}

  .dash-h{font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--white);margin:0 0 12px}
  .sevdist{margin-bottom:30px}
  .sevdist .legend{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:10px;font-size:12px;color:var(--gray-light)}
  .sevdist .legend .lg{display:inline-flex;align-items:center;gap:6px}
  .sevdist .legend .sw{width:11px;height:11px;border-radius:2px;flex:0 0 auto}
  .distbar{display:flex;height:30px;border-radius:var(--radius-md);overflow:hidden;background:var(--gray-dark)}
  .distbar .seg{display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;
    color:rgba(0,0,0,.7);min-width:0;overflow:hidden}
  .distbar .seg.sev-critical{color:#fff}

  .cols{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-bottom:8px}
  .col h3{font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--white);margin:0 0 16px}
  .brow{margin-bottom:14px}
  .brow .top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px}
  .brow .name{font-family:var(--font-display);font-size:13.5px;font-weight:500;color:var(--white)}
  .brow .n{font-size:13px;color:var(--gray-mid);font-family:var(--mono)}
  .brow .track{height:8px;border-radius:99px;background:transparent}
  .brow .bar{display:flex;height:8px;border-radius:99px;overflow:hidden;min-width:6px}
  .brow .bar .seg{height:100%}
  @media(max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr;gap:8px}}

  /* Findings filter toolbar — sticky search + severity toggles (inline JS drives
     it; degrades to showing everything if scripts are disabled). */
  .toolbar{position:sticky;top:0;z-index:20;background:var(--black);margin:30px 0 6px;
    padding:14px 0 12px;border-bottom:.5px solid var(--line);
    display:flex;flex-wrap:wrap;align-items:center;gap:12px}
  .sw-search{flex:1 1 280px;min-width:180px;background:var(--card);color:var(--white);
    border:.5px solid var(--line);border-radius:var(--radius-md);padding:9px 12px;font-size:13px;
    font-family:var(--font-body)}
  .sw-search::placeholder{color:var(--gray-mid)}
  .sw-search:focus{outline:none;border-color:var(--amber)}
  .sevtoggles{display:flex;flex-wrap:wrap;gap:6px}
  .sevtog{cursor:pointer;font-size:10px;font-weight:600;letter-spacing:.3px;text-transform:uppercase;
    padding:5px 10px;border-radius:99px;border:1px solid var(--line);background:transparent;color:var(--gray-mid);
    display:inline-flex;align-items:center;gap:6px;font-family:var(--font-body);transition:opacity .12s,border-color .12s,color .12s}
  .sevtog::before{content:'';width:8px;height:8px;border-radius:2px;background:var(--gray-dark)}
  .sevtog .c{font-family:var(--mono);opacity:.8}
  .sevtog:not(.active){opacity:.45}
  .sevtog.active{color:var(--white);border-color:var(--gray-mid)}
  .sevtog[data-sev=critical].active::before{background:#F85149}
  .sevtog[data-sev=high].active::before{background:#F0883E}
  .sevtog[data-sev=medium].active::before{background:#F0C840}
  .sevtog[data-sev=low].active::before{background:#45C4B0}
  .sevtog[data-sev=info].active::before{background:#8F8F8F}
  .sw-count{margin-left:auto;color:var(--gray-mid);font-size:12px;font-family:var(--mono);white-space:nowrap}
  .noresults{color:var(--gray-mid);font-style:italic;margin:24px 0}

  /* Severity badges */
  .chip{display:inline-flex;align-items:center;font-size:10px;font-weight:500;letter-spacing:.3px;
    text-transform:uppercase;padding:3px 8px;border-radius:var(--radius-sm)}
  .chip.sev-critical{color:#fff;background:var(--danger)}
  .chip.sev-high{color:#ffd0cb;background:rgba(248,81,73,.16);border:1px solid rgba(248,81,73,.5)}
  .chip.sev-medium{color:var(--dark);background:var(--amber)}
  .chip.sev-low{color:var(--amber);background:transparent;border:1px solid var(--amber)}
  .chip.sev-info{color:var(--gray-mid);border:1px solid var(--gray-dark)}
  .chip.clean{color:var(--dark);background:var(--ok)}

  /* Axis heading */
  h2.axis{font-family:var(--font-display);font-size:13px;text-transform:uppercase;letter-spacing:1.5px;
    color:var(--amber);margin:38px 0 14px;font-weight:700;display:flex;align-items:center;gap:12px}
  h2.axis::after{content:'';flex:1;height:.5px;background:var(--line)}

  /* Problem groups — one card per check, listing every affected resource.
     The whole card is a native <details>; collapsed, only the summary line
     (severity · problem · count) shows, so a long report stays scannable. */
  .group{background:var(--card);border:.5px solid var(--line);border-left:3px solid var(--gray-dark);
    border-radius:var(--radius-lg);margin-bottom:10px;overflow:hidden}
  .group.sev-critical,.group.sev-high{border-left-color:var(--danger)}
  .group.sev-medium{border-left-color:var(--amber)}
  .group.sev-low{border-left-color:var(--yellow-light)}
  .group.sev-info{border-left-color:var(--gray-mid)}
  .group > summary.ghead{display:flex;align-items:center;gap:10px;cursor:pointer;
    list-style:none;user-select:none;padding:14px 18px}
  .group > summary.ghead::-webkit-details-marker{display:none}
  .group > summary.ghead .gtitle{flex:1 1 auto;min-width:0;font-family:var(--font-display);
    font-weight:500;font-size:15px;color:var(--white)}
  .group > summary.ghead .count{flex:0 0 auto;color:var(--gray-mid);font-size:12px;font-family:var(--mono)}
  .group > summary.ghead::after{content:'';flex:0 0 auto;width:7px;height:7px;
    border-right:1.6px solid var(--gray-mid);border-bottom:1.6px solid var(--gray-mid);
    transform:rotate(45deg);transition:transform .15s ease}
  .group[open] > summary.ghead::after{transform:rotate(-135deg)}
  .group > summary.ghead:hover .gtitle{color:var(--amber)}
  .group > summary.ghead:hover::after{border-color:var(--amber)}
  .group > summary.ghead:focus-visible{outline:1px solid var(--amber);outline-offset:-3px;
    border-radius:var(--radius-sm)}
  .gbody{padding:0 18px 14px}
  .gbody .desc{margin:0 0 8px;color:var(--gray-light);font-size:13px}
  .gbody .rem{margin:0 0 10px;color:var(--gray-mid);font-size:12.5px}
  .gbody .rem b{color:var(--amber);font-weight:500}

  /* Affected-resource list */
  ul.affected{list-style:none;margin:0;padding:0;border-top:.5px solid var(--line)}
  ul.affected > li{padding:7px 2px;border-bottom:.5px solid var(--line)}
  ul.affected > li:last-child{border-bottom:0}
  ul.affected .rtitle{color:var(--gray-light);font-size:13px}
  ul.affected .aside{color:var(--yellow-light);font-family:var(--mono);font-size:12px;margin-left:6px}
  ul.affected .chip{margin-right:8px;vertical-align:1px}
  ul.affected details.ev{margin-top:5px}
  ul.affected details.ev > summary{cursor:pointer;color:var(--gray-mid);font-size:11px}
  .gfoot{margin-top:10px;color:var(--gray-mid)}
  pre{background:var(--black);border:.5px solid var(--line);border-radius:var(--radius-md);
    padding:10px 12px;overflow:auto;font-size:12px;color:var(--gray-light);margin:8px 0 0;font-family:var(--mono)}
  pre.ghfix{color:var(--amber);border-color:rgba(255,182,31,.35)}
  .cid{font-family:var(--mono);font-size:11px;color:var(--gray-mid)}

  /* Team design */
  .teamdesign{position:relative;background:var(--card);border:.5px solid var(--line);
    border-radius:var(--radius-lg);padding:16px 18px;margin-top:8px;overflow:hidden}
  .teamdesign::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--amber)}
  .teamdesign .td-head{font-family:var(--font-display);font-size:15px;font-weight:500;color:var(--amber);margin:0 0 2px}
  .teamdesign .td-exp{color:var(--gray-mid);font-size:12px;margin:0 0 10px}
  .teamdesign .td-list{margin:6px 0 10px;padding-left:20px}
  .teamdesign .td-list li{margin:2px 0}
  .teamdesign .td-clean{color:var(--ok);margin:6px 0 10px}
  .teamdesign table.td-own{border-collapse:collapse;font-size:13px;margin:4px 0 6px}
  .teamdesign table.td-own td{padding:4px 14px 4px 0}
  .teamdesign table.td-own td:last-child{font-family:var(--mono);color:var(--yellow-light)}
  .teamdesign .td-gaps-h{margin:10px 0 2px;color:var(--gray-light)}

  /* Coverage — collapsible, with an axis-style heading as the summary */
  summary.axissum{font-family:var(--font-display);font-size:13px;text-transform:uppercase;letter-spacing:1.5px;
    color:var(--amber);margin:38px 0 14px;font-weight:700;display:flex;align-items:center;gap:12px;
    cursor:pointer;list-style:none;user-select:none}
  summary.axissum::-webkit-details-marker{display:none}
  summary.axissum .line{flex:1 1 auto;height:.5px;background:var(--line)}
  summary.axissum .axiscount{flex:0 0 auto;font-size:11px;text-transform:none;letter-spacing:0;
    font-weight:400;color:var(--gray-mid);font-family:var(--mono)}
  summary.axissum::after{content:'';flex:0 0 auto;width:7px;height:7px;
    border-right:1.6px solid var(--gray-mid);border-bottom:1.6px solid var(--gray-mid);
    transform:rotate(45deg);transition:transform .15s ease}
  details.axissection[open] > summary.axissum::after{transform:rotate(-135deg)}
  summary.axissum:hover{color:var(--yellow-light)}
  summary.axissum:hover::after{border-color:var(--amber)}
  summary.axissum:focus-visible{outline:1px solid var(--amber);outline-offset:3px;border-radius:var(--radius-sm)}
  table.cov{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
  table.cov td{padding:7px 10px;border-bottom:.5px solid var(--line)}
  table.cov .mark{width:24px;text-align:center;font-weight:700}
  .ok{color:var(--ok)} .partial{color:var(--amber)} .missing{color:var(--danger)}
  .reason{color:var(--gray-mid);font-size:12px}
  .lever{background:var(--card);border-left:3px solid var(--amber);border-radius:6px;
    padding:14px 18px;margin:22px 0}
  .lever-h{color:var(--amber);font-weight:600;letter-spacing:.04em;text-transform:uppercase;
    font-size:.72rem;margin:0 0 6px}
  .lever-s{color:var(--white);margin:0}
  .lever-c{color:var(--gray-light);font-size:.86rem;margin:6px 0 0}
  .neval{color:var(--gray-light);margin:6px 0}
  .neval .cid{margin-left:6px}
  .empty{color:var(--gray-mid);font-style:italic}

  /* Footer */
  footer{margin-top:48px;padding-top:18px;border-top:.5px solid var(--line);color:var(--gray-mid);
    font-size:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  footer .by{margin-left:auto;color:var(--gray-mid)}
  footer b{color:var(--amber);font-weight:500}
</style>
</head>
<body><div class="wrap">

<header class="top">
  <img class="sunlogo" src="data:image/png;base64," alt="Sunny Systems" height="26">
  <span class="hsep"></span>
  <span class="brand">scopeward</span>
  <span class="org">{{.OrgDisplay}}</span>
  <span class="gen">generated {{.GeneratedAt}}</span>
</header>
<hr class="rule">

<section class="scorecard">
  <div class="gauge" style="--score:{{.Score.Value}};--grade-color:{{.GradeColor}}">
    <span class="val">{{.Score.Value}}</span>
    <span class="grade">grade {{.Score.Grade}}</span>
  </div>
  <div class="scoremeta">
    <h1>Governance score</h1>
    <p>{{.FindingCount}} findings across {{.AxisCount}} axes · {{.CheckCount}} checks evaluated</p>
    {{if .ScoreBasis}}<p class="neval">{{.ScoreBasis}}</p>{{end}}
    {{if .ScoreEstimate}}<p class="neval">{{.ScoreEstimate}}</p>{{end}}
    {{if .ScoreTransition}}<p class="neval">{{.ScoreTransition}}</p>{{end}}
    <div class="tally">
      {{- if .Severities}}
        {{- range .Severities}}<span class="chip sev-{{.Key}}">{{.Count}} {{.Key}}</span>{{end}}
      {{- else}}<span class="chip clean">no findings</span>{{end}}
    </div>
  </div>
</section>

{{with .Dashboard}}{{if .Total}}
<section class="stats">
  <div class="stat"><div class="num">{{.Total}}</div><div class="lbl">Total findings</div></div>
  <div class="stat"><div class="num crit">{{.Critical}}</div><div class="lbl">Critical</div></div>
  <div class="stat"><div class="num high">{{.High}}</div><div class="lbl">High</div></div>
  <div class="stat"><div class="num">{{.AffectedRepos}}</div><div class="lbl">Affected repos</div></div>
  <div class="stat"><div class="num">{{.Categories}}</div><div class="lbl">Action categories</div></div>
</section>

<div class="sevdist">
  <p class="dash-h">Severity distribution</p>
  <div class="legend">
    {{range .SevLegend}}<span class="lg"><span class="sw sev-fill-{{.Key}}"></span>{{.Key}} · {{.Count}}</span>{{end}}
  </div>
  <div class="distbar">
    {{range .SevBar}}<span class="seg sev-{{.Key}} sev-fill-{{.Key}}" style="width:{{.Width}}">{{if .ShowLabel}}{{.Count}}{{end}}</span>{{end}}
  </div>
</div>

<div class="cols">
  <div class="col">
    <h3>Where they are · by governance area</h3>
    {{range .ByArea}}<div class="brow">
      <div class="top"><span class="name">{{.Label}}</span><span class="n">{{.Count}}</span></div>
      <div class="bar" style="width:{{.BarWidth}}">{{range .Segs}}<span class="seg sev-fill-{{.Key}}" style="width:{{.Width}}"></span>{{end}}</div>
    </div>{{end}}
  </div>
  <div class="col">
    <h3>What kind of action · by category</h3>
    {{range .ByCategory}}<div class="brow">
      <div class="top"><span class="name">{{.Label}}</span><span class="n">{{.Count}}</span></div>
      <div class="bar" style="width:{{.BarWidth}}">{{range .Segs}}<span class="seg sev-fill-{{.Key}}" style="width:{{.Width}}"></span>{{end}}</div>
    </div>{{end}}
  </div>
</div>
{{end}}{{end}}

{{with .ArchiveLever}}
<div class="lever">
  <p class="lever-h">Biggest lever</p>
  <p class="lever-s">{{.Summary}}</p>
  <p class="lever-c">{{.Caution}}</p>
</div>
{{end}}

{{if .Axes}}
<div class="toolbar">
  <input id="sw-search" class="sw-search" type="search" list="sw-suggest" autocomplete="off"
    placeholder="Search findings by repo, problem, area, or category…">
  <datalist id="sw-suggest">{{range .Suggestions}}<option value="{{.}}"></option>{{end}}</datalist>
  <div class="sevtoggles">
    {{range .Dashboard.SevLegend}}<button type="button" class="sevtog active" data-sev="{{.Key}}">{{.Key}} <span class="c">{{.Count}}</span></button>{{end}}
  </div>
  <span class="sw-count" id="sw-count"></span>
</div>
<p class="noresults" id="sw-noresults" hidden>No findings match your filters.</p>
{{end}}

{{range .Axes}}
<section class="faxis">
<h2 class="axis">{{.Title}}</h2>
{{range .Groups}}
<details class="group sev-{{.SeverityClass}}" data-text="{{.Search}}" data-open="{{if .Open}}1{{else}}0{{end}}"{{if .Open}} open{{end}}>
  <summary class="ghead">
    <span class="chip sev-{{.SeverityClass}}">{{.Severity}}</span>
    <span class="gtitle">{{.Label}}</span>
    <span class="count">{{.CountLabel}}</span>
  </summary>
  <div class="gbody">
    <p class="desc">{{.Description}}</p>
    {{if .Remediation}}<p class="rem"><b>Fix:</b> {{.Remediation}}</p>{{end}}
    <ul class="affected">
      {{range .Items}}<li data-sev="{{.SeverityClass}}" data-text="{{.Search}}">
        {{if .ShowChip}}<span class="chip sev-{{.SeverityClass}}">{{.Severity}}</span>{{end}}<span class="rtitle">{{if .ResourceURL}}<a href="{{.ResourceURL}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}</span>{{if .AsideName}}<span class="aside">{{.AsideName}}</span>{{end}}
        {{if or .Evidence .GHFix}}<details class="ev"><summary>details</summary>
          {{if .GHFix}}<pre class="ghfix" title="scopeward never runs this; review before running">{{.GHFix}}{{if .GHVerify}}

# verify: {{.GHVerify}}{{end}}</pre>{{end}}
          {{if .Evidence}}<pre>{{.Evidence}}</pre>{{end}}
        </details>{{end}}
      </li>{{end}}
    </ul>
    <div class="gfoot rem"><span class="cid">{{.CheckID}}</span>{{if .Policy}} · <b>POLICY</b> — your organization declared this rule{{end}}{{if .DocsURL}} · <a href="{{.DocsURL}}">docs</a>{{end}}</div>
  </div>
</details>
{{end}}
</section>
{{end}}

{{if not .Axes}}<p class="empty">No findings. Every evaluated check passed.</p>{{end}}

{{with .TeamDesign}}
<h2 class="axis">Team Design</h2>
<div class="teamdesign">
  <p class="td-head">{{.Tier}} · {{.Teams}} teams, depth {{.Depth}}</p>
  <p class="td-exp">Expected here: {{.Expected}}.</p>
  {{if .Structure}}<ul class="td-list">{{range .Structure}}<li>{{.}}</li>{{end}}</ul>
  {{else}}<p class="td-clean">Team structure looks clean.</p>{{end}}
  <table class="td-own">
    <tr><td>repos with an owning team</td><td>{{.OwningTeam}}</td></tr>
    <tr><td>repos with a team code owner</td><td>{{.CodeOwner}}</td></tr>
    <tr><td><code>owning-team</code> property</td><td>{{.Property}}</td></tr>
  </table>
  {{if .Gaps}}<p class="td-gaps-h"><b>Gaps</b></p><ul class="td-list">{{range .Gaps}}<li>{{.}}</li>{{end}}</ul>{{end}}
</div>
{{end}}

{{if .PartlyEvaluated}}
<h2 class="axis">Partially evaluated</h2>
{{range .PartlyEvaluated}}<p class="neval">~ {{.Title}} <span class="cid">{{.CheckID}} · assessed {{.Assessed}}, {{.Omitted}} not assessed</span><br>
{{.Reason}}</p>{{end}}
{{end}}

{{if .NotEvaluated}}
<h2 class="axis">Not evaluated</h2>
{{range .NotEvaluated}}<p class="neval">~ {{.Title}} <span class="cid">{{.CheckID}} · {{.Cause}}</span></p>{{end}}
{{end}}

{{if .AcceptedRisks}}
<h2 class="axis">Accepted risks</h2>
{{if .SuppressionDelta}}<p class="neval">{{.SuppressionDelta}}</p>{{end}}
{{range .AcceptedRisks}}<p class="neval">{{.Title}} <span class="cid">{{.CheckID}}</span><br>
{{if .Reason}}{{.Reason}}{{else}}<b>no reason recorded</b>{{end}}</p>{{end}}
{{end}}

<details class="axissection">
  <summary class="axissum">Coverage<span class="line"></span>{{if .CoverageSummary}}<span class="axiscount">{{.CoverageSummary}}</span>{{end}}</summary>
  <table class="cov">
  {{range .Coverage}}<tr>
    <td class="mark {{.Class}}">{{.Mark}}</td>
    <td>{{.Kind}}</td>
    <td class="reason">{{.Reason}}</td>
  </tr>{{end}}
  </table>
</details>

<footer>Generated locally by <a href="https://sunnysystems.com.br/products/scopeward"><b>scopeward</b></a><span class="by">Built by Sunny Systems</span></footer>

</div>
<script>
/* Findings filter: free-text search (matches problem, repo, area, category) plus
   severity toggles. Pure DOM, no dependencies, no network — the report stays a
   single self-contained file. With scripts disabled, everything simply shows. */
(function () {
  var search = document.getElementById('sw-search');
  if (!search) return; // no findings, no toolbar
  var countEl = document.getElementById('sw-count');
  var noResults = document.getElementById('sw-noresults');
  var toggles = [].slice.call(document.querySelectorAll('.sevtog'));
  var groups = [].slice.call(document.querySelectorAll('.faxis .group'));
  var sections = [].slice.call(document.querySelectorAll('.faxis'));
  var total = document.querySelectorAll('.faxis .affected > li').length;

  function activeSevs() {
    var s = {};
    toggles.forEach(function (t) {
      if (t.classList.contains('active')) s[t.getAttribute('data-sev')] = true;
    });
    return s;
  }

  function apply() {
    var query = (search.value || '').trim().toLowerCase();
    var tokens = query ? query.split(/\s+/) : [];
    var sevs = activeSevs();
    var searching = tokens.length > 0;
    var shownTotal = 0;

    groups.forEach(function (g) {
      var gtext = g.getAttribute('data-text') || '';
      var items = [].slice.call(g.querySelectorAll('.affected > li'));
      var shown = 0;
      items.forEach(function (li) {
        var hay = gtext + ' ' + (li.getAttribute('data-text') || '');
        var matches = !searching || tokens.every(function (t) { return hay.indexOf(t) !== -1; });
        var visible = matches && !!sevs[li.getAttribute('data-sev')];
        li.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      var groupVisible = shown > 0;
      g.style.display = groupVisible ? '' : 'none';
      if (groupVisible) {
        shownTotal += shown;
        g.open = searching ? true : g.getAttribute('data-open') === '1';
      }
    });

    sections.forEach(function (sec) {
      var any = [].slice.call(sec.querySelectorAll('.group')).some(function (g) {
        return g.style.display !== 'none';
      });
      sec.style.display = any ? '' : 'none';
    });

    if (countEl) countEl.textContent = shownTotal === total ? total + ' findings' : shownTotal + ' of ' + total + ' findings';
    if (noResults) noResults.hidden = shownTotal !== 0;
  }

  search.addEventListener('input', apply);
  toggles.forEach(function (t) {
    t.addEventListener('click', function () { t.classList.toggle('active'); apply(); });
  });
  apply();
})();
</script>
</body></html>
